        <bpmn:flowNodeRef>GwAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InputCred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InputOtpReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ForgotInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dashboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MenuAI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MenuRiwayat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MenuData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AddTxn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Chat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Sistem Soju">
        <bpmn:flowNodeRef>Init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MarkDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendOtpReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwOtpReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendOtpReset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InputOtpReset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FormManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ShowDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UpdateReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="Asisten AI">
        <bpmn:flowNodeRef>ResetPw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AiParse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Buka Aplikasi" />
    <bpmn:task id="Init" name="Inisialisasi &amp; cek sesi" />
    <bpmn:exclusiveGateway id="GwOnboard" name="Pertama kali?" />
    <bpmn:userTask id="Onb1" name="Onboarding 1&#10;Kelola Keuangan" />
    <bpmn:userTask id="Onb2" name="Onboarding 2&#10;Asisten AI" />
    <bpmn:userTask id="Onb3" name="Onboarding 3&#10;Tumbuh Percaya Diri" />
    <bpmn:userTask id="Onb4" name="Onboarding 4&#10;Chat AI" />
    <bpmn:userTask id="Onb5" name="Onboarding 5&#10;Kontrol Stok" />
    <bpmn:userTask id="Onb6" name="Onboarding 6&#10;Laporan" />
    <bpmn:task id="MarkDone" name="Simpan status onboarding" />
    <bpmn:userTask id="LoginPage" name="Halaman Login" />
    <bpmn:exclusiveGateway id="GwAction" name="Pilih aksi" />
    <bpmn:userTask id="InputCred" name="Input email &amp; password" />
    <bpmn:task id="Validate" name="Validasi kredensial" />
    <bpmn:exclusiveGateway id="GwValid" name="Valid?" />
    <bpmn:userTask id="Register" name="Registrasi akun" />
    <bpmn:task id="SendOtpReg" name="Kirim kode OTP" />
