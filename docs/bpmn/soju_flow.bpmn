    <bpmn:exclusiveGateway id="GwOtpReg" name="OTP valid?" />
    <bpmn:userTask id="ForgotInput" name="Input email pemulihan" />
    <bpmn:task id="SendOtpReset" name="Kirim OTP reset" />
    <bpmn:task id="InputOtpReset" name="Input OTP reset" />
    <bpmn:userTask id="ResetPw" name="Atur ulang password" />
    <bpmn:userTask id="Dashboard" name="Dashboard Soju" />
    <bpmn:exclusiveGateway id="GwMenu" name="Pilih menu" />
    <bpmn:userTask id="MenuAI" name="Menu Asisten AI" />
    <bpmn:userTask id="MenuRiwayat" name="Menu Riwayat &amp; Audit" />
    <bpmn:userTask id="MenuData" name="Menu Data" />
    <bpmn:userTask id="AddTxn" name="Klik &quot;+ Tambah Transaksi&quot;" />
    <bpmn:exclusiveGateway id="GwMethod" name="Metode input?" />
    <bpmn:userTask id="FormManual" name="Isi form transaksi&#10;(tanggal, deskripsi,&#10;jenis, nominal)" />
    <bpmn:userTask id="Chat" name="Chat / unggah struk" />
    <bpmn:task id="AiParse" name="AI parsing &amp;&#10;kategorisasi otomatis" />
    <bpmn:task id="ShowDraft" name="Tampilkan draf transaksi" />
    <bpmn:userTask id="Confirm" name="Konfirmasi draf" />
    <bpmn:exclusiveGateway id="GwApprove" name="Disetujui?" />
    <bpmn:task id="Save" name="Simpan ke pembukuan" />
    <bpmn:task id="UpdateReport" name="Update dashboard &amp; laporan" />
    <bpmn:endEvent id="End" name="Selesai" />
